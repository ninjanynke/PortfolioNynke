---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lottie from '../components/Lottie.astro';
import animationUrl from '../assets/lottie/about-me.json?url';

const page = await getEntry('pages', 'aboutme');
if (!page) throw new Error('src/content/pages/aboutme.md is missing');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="container about">
    <div class="about-section">
      <div class="about-grid">
        <h1 class="about-heading">{page.data.title}</h1>
        <Lottie src={animationUrl} class="about-animation" label="Photo of Nynke with colourful circles" />
        <div class="about-text rich-text">
          <Content />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-section {
    display: flex;
    margin-top: 20px;
  }

  .about-grid {
    display: grid;
    flex: 1;
    grid-template:
      "heading   animation"
      "text      animation" minmax(auto, 1fr)
      / 1fr 0.5fr;
    grid-auto-columns: 1fr;
    gap: 20px;
  }

  .about-heading {
    grid-area: heading;
    margin: 0;
    text-align: left;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    line-height: 30px;
  }

  .about-grid :global(.about-animation) {
    grid-area: animation;
  }

  .about-text {
    grid-area: text;
  }

  @media screen and (max-width: 767px) {
    .about {
      padding-left: 20px;
      padding-right: 20px;
    }

    .about-grid {
      grid-template:
        "heading"
        "animation" minmax(auto, 1fr)
        "text"
        "text"
        / 2fr;
    }

    .about-heading {
      align-self: center;
    }

    .about-grid :global(.about-animation) {
      width: 50%;
      align-self: center;
      justify-self: center;
    }
  }

  @media screen and (max-width: 479px) {
    .about-grid :global(.about-animation) {
      width: 100%;
    }
  }
</style>

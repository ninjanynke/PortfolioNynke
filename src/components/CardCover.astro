---
// A card's cover image, filling its box like `background-size: cover`
// (centred, cropped to fit). Resized copies at the card's display size,
// so category pages don't load full-size covers. GIFs become animated
// WebP (Astro's sharp service keeps every frame).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  // Candidate widths for srcset; ones wider than the original are dropped.
  widths: number[];
  // Rendered width in the layout, for `sizes`.
  sizes: string;
  loading?: 'eager' | 'lazy';
}

const { src, widths, sizes, loading = 'lazy' } = Astro.props;
const fit = widths.filter((w) => w < src.width);
---

<Image src={src} widths={fit.length ? fit : [src.width]} sizes={sizes} alt="" loading={loading} class="cover" />

<style>
  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50%;
  }
</style>

---
// A project image inside a lightbox link: the link opens a large version,
// the <img> shows a size fit for the layout. GIFs become animated WebP
// (Astro's sharp service keeps every frame).
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt?: string;
  // Links with the same group page through each other in the lightbox.
  group?: string;
  // Rendered width in the layout, for `sizes`.
  sizes: string;
  class?: string;
  imgClass?: string;
  style?: string;
}

const { src, alt = '', group, sizes, class: className, imgClass, style } = Astro.props;
const large = await getImage({ src, width: Math.min(src.width, 2000) });
const widths = [400, 800, 1200, 1600].filter((w) => w < src.width).concat(src.width);
// Resized copies have rounded heights, so their shape drifts a little from
// the original's. The layout uses the original's exact shape instead, as
// Webflow did (see --ratio in the page styles).
const ratio = `--ratio: ${src.width} / ${src.height}`;
---

<a href={large.src} data-lightbox={group ?? ''} class={className} style={style}>
  <Image src={src} widths={widths} sizes={sizes} alt={alt} class={imgClass} style={ratio} />
  <slot />
</a>

---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  colour: string;
}

const { project, colour } = Astro.props;
const { title, cover, type, featuredTag } = project.data;
---

<li class="card-slot" data-card>
  <a href={`/projects/${project.id}`} class="card">
    <div class="card-inner">
      <div class="card-image" style={cover ? `background-image: url("${cover.src}")` : undefined}>
        <div class="card-veil">
          <div class="card-tags">
            {[type, featuredTag].filter(Boolean).map((tag) => (
              <div class="card-tag" data-tag style={`--tag-colour: ${colour}`}>
                <span class="card-tag-text">{tag}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="card-title-box">
        <div class="card-title">{title}</div>
      </div>
    </div>
  </a>
</li>

<script>
  import { splitTagLines } from '../scripts/tag-lines';
  splitTagLines('[data-tag]');
</script>

<style>
  /* Image on top (height 96% of the width), title underneath in a strip
     24% of the width high: a 5:6 card, as on Webflow. A title too long
     for the strip makes the card taller instead of running out of it. */
  .card-slot {
    container-type: inline-size;
    width: 100%;
  }

  .card {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 100 / 96;
    overflow: hidden;
    border: 1px solid var(--dark-grey);
    border-radius: 5px;
    background-position: 50%;
    background-size: cover;
  }

  .card-veil {
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.35);
    transition: background-color 0.2s;
  }

  /* Active: veil clears (200 ms) and tags fade in (500 ms). */
  .card-slot.is-active .card-veil {
    background-color: rgba(255, 255, 255, 0);
  }

  .card-slot.is-active .card-tag {
    opacity: 1;
  }

  .card-tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  /* Tags hidden and image veiled at rest. Active state, one look at every
     width (a deliberate change from the live site, which only did this from
     992px up): triggered by hover on devices that can hover, and by
     scrolling on touch screens and narrow windows (scroll-activate.ts
     toggles .is-active). */
  /* Tags look exactly like the live site's on one line: a 20px pill, tags
     10px apart. A tag that doesn't fit wraps at the spaces into one pill
     per line, flush right, lines touching; tag-lines.ts splits the lines
     and squares off the corners where they touch. Without the script,
     box-decoration-break gives each wrapped line its own pill. */
  .card-tag {
    margin: 10px 10px 0;
    text-align: right;
    font-family: var(--font-ui);
    line-height: 20px;
    opacity: 0;
    transition: opacity 500ms;
  }

  .card-tag :global(.card-tag-text),
  .card-tag :global(.card-tag-line) {
    padding: 1px 10px;
    border-radius: 4px;
    background-color: var(--tag-colour);
    color: #fff;
    text-transform: lowercase;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .card-tag:global(.is-split) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .card-tag :global(.card-tag-line) {
    padding: 0 10px;
    white-space: nowrap;
  }

  .card-tag :global(.sq-tl) { border-top-left-radius: 0; }
  .card-tag :global(.sq-tr) { border-top-right-radius: 0; }
  .card-tag :global(.sq-bl) { border-bottom-left-radius: 0; }
  .card-tag :global(.sq-br) { border-bottom-right-radius: 0; }

  /* The title strip has a fixed height, so rows are spaced as on Webflow
     whatever the titles. On narrow cards a two-line title runs past the
     strip into the space between rows, as it did there. */
  .card-title-box {
    height: 24cqw;
    padding: 10px 10px 0;
  }

  /* Except in the last row, which ends at its longest title, so the space
     before the footer is the same whatever the titles are.
     ("of .card-slot": the list also holds this component's script.) */
  @media screen and (min-width: 480px) {
    .card-slot:nth-child(4n + 1 of .card-slot):nth-last-child(-n + 4 of .card-slot) .card-title-box,
    .card-slot:nth-child(4n + 1 of .card-slot):nth-last-child(-n + 4 of .card-slot) ~ .card-slot .card-title-box {
      height: auto;
    }
  }

  @media screen and (max-width: 479px) {
    .card-slot:nth-child(2n + 1 of .card-slot):nth-last-child(-n + 2 of .card-slot) .card-title-box,
    .card-slot:nth-child(2n + 1 of .card-slot):nth-last-child(-n + 2 of .card-slot) ~ .card-slot .card-title-box {
      height: auto;
    }
  }

  /* At most two lines; a longer title ends in "…". */
  .card-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin: 0;
    color: var(--dim-grey);
    text-align: center;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
  }

  @media (hover: hover) {
    .card-veil:hover {
      background-color: rgba(255, 255, 255, 0);
    }

    .card:hover .card-tag {
      opacity: 1;
    }
  }
</style>

---
import logo from '../assets/site/logo.svg';

const cvHref = '/cv/nynke-zwart-cv.pdf';
---

<header class="site-header">
  <nav class="container" aria-label="Main">
    <ul class="nav-grid list-reset">
      <li class="nav-home">
        <a href="/" class="home-link" aria-label="Nynke Zwart, home">
          <img src={logo.src} alt="" class="nav-logo" />
          <span class="nav-name">NYNKE<br />ZWART</span>
        </a>
      </li>
      <li><a href="/aboutme" class="nav-link">About me</a></li>
      <li><a href={cvHref} class="nav-link">My CV</a></li>
    </ul>
  </nav>
</header>
<div class="header-shadow"></div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: 20px;
    background-color: var(--background);
  }

  .nav-grid {
    display: grid;
    grid-template-columns: 1fr max-content max-content max-content;
    grid-template-rows: auto;
    grid-auto-columns: max-content;
    grid-auto-flow: column;
    gap: 20px;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
  }

  .nav-home {
    justify-self: start;
  }

  .home-link {
    display: flex;
    align-items: center;
    height: 40px;
    max-width: 100%;
    color: var(--dim-grey);
    font-size: 12px;
    font-weight: 700;
    transition: all 0.3s;
  }

  .home-link:hover,
  .nav-link:hover {
    color: var(--dark-grey);
  }

  .nav-logo {
    object-fit: contain;
    object-position: 0% 50%;
  }

  .nav-name {
    display: block;
    padding-left: 10px;
    color: #4e4e4e;
    font-weight: 700;
    line-height: 16px;
  }

  .nav-link {
    color: var(--dim-grey);
    text-align: right;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    transition: all 0.3s;
  }

  .header-shadow {
    position: sticky;
    top: 0;
    width: 100%;
    box-shadow: 0 0 4px 1px var(--box-shadow);
  }

  @media screen and (max-width: 767px) {
    .site-header {
      position: relative;
      padding-left: 20px;
    }

    .nav-grid {
      text-align: center;
    }
  }

  @media screen and (max-width: 479px) {
    .site-header {
      position: sticky;
      padding: 0;
    }

    .nav-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(auto-fit, minmax(76px, 1fr));
      grid-auto-flow: row;
      gap: 0;
      padding-bottom: 20px;
    }

    .nav-home {
      grid-column: span 2;
      justify-self: center;
    }

    .nav-name {
      padding-left: 0;
    }

    .home-link,
    .nav-link {
      display: flex;
      justify-content: center;
    }
  }
</style>

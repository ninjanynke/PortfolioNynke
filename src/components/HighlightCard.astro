---
import type { CollectionEntry } from 'astro:content';
import CardCover from './CardCover.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  colour: string;
}

const { project, colour } = Astro.props;
const { title, summary, highlightSummary, cover, type, featuredTag, startDate } = project.data;
const tags = [featuredTag, type].filter(Boolean);
---

<li data-highlight>
  <a href={`/projects/${project.id}`} class="highlight">
    <div class="highlight-card">
      <div>
        <div class="highlight-image">
          {cover && (
            <CardCover
              src={cover}
              widths={[450, 900, 1300]}
              sizes="(max-width: 479px) calc(100vw - 80px), (max-width: 767px) calc(50vw - 68px), (max-width: 991px) 316px, 422px"
              loading="eager"
            />
          )}
        </div>
        <div class="highlight-title" style={`border-color: ${colour}`}>{title}</div>
        <p class="highlight-summary">{highlightSummary ?? summary}</p>
      </div>
      <div class="highlight-tags">
        {tags.map((tag) => <div class="tag" style={`background-color: ${colour}`}>{tag}</div>)}
        {startDate && <div class="tag tag-last" style={`background-color: ${colour}`}>{startDate.getFullYear()}</div>}
      </div>
    </div>
  </a>
</li>

<style>
  .highlight {
    display: inline-block;
    width: 100%;
    max-width: 100%;
  }

  .highlight-card {
    padding: 20px;
    border-radius: 10px;
    transition: box-shadow 0.2s linear;
  }

  /* Active: shadow fades in (200 ms). Triggered by hover on devices that
     can hover, and by scrolling on touch screens and narrow windows
     (scroll-activate.ts toggles .is-active). */
  li.is-active .highlight-card {
    box-shadow: 3px 3px 10px 1px var(--box-shadow);
  }

  @media (hover: hover) {
    .highlight-card:hover {
      box-shadow: 3px 3px 10px 1px var(--box-shadow);
    }
  }

  .highlight-image {
    position: relative;
    width: 100%;
    padding-bottom: 50%;
    overflow: hidden;
    border-radius: 5px;
  }

  .highlight-title {
    display: inline-block;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #000;
    color: #000;
    font-family: var(--font-ui);
  }

  .highlight-summary {
    color: #000;
    font-weight: 400;
  }

  .highlight-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .tag {
    display: inline-block;
    margin-right: 10px;
    margin-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 5px;
    color: #fff;
    text-transform: lowercase;
    font-family: var(--font-ui);
  }

  .tag-last {
    display: block;
    margin-right: 0;
  }
</style>

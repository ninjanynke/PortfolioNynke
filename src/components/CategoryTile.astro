---
import type { CollectionEntry } from 'astro:content';

interface Props {
  category: CollectionEntry<'categories'>;
}

const { category } = Astro.props;
const { title, colour, logo, logoHover } = category.data;
---

<li class="tile-slot">
  <a
    href={`/site-categories/${category.id}`}
    class="tile"
    style={`background-color: ${colour}`}
    data-tile
  >
    <div class="tile-inner">
      <div class="logo-stack">
        {logo && <img src={logo.src} width="168" alt="" class="logo-outline" />}
        {logoHover && <img src={logoHover.src} alt="" class="logo-filled" />}
      </div>
      <div class="tile-label">
        <div class="label-colour" style={`color: ${colour}`}>{title}</div>
        <div class="label-white">{title}</div>
      </div>
    </div>
  </a>
</li>

<style>
  /* Square slot: the padding trick keeps a 1:1 ratio at every width. */
  .tile-slot {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    transition: all 0.625s;
  }

  .tile {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    max-width: 100%;
    border-radius: 4px;
    transition: all 0.625s;
  }

  /* White layer that fades in over the category colour when active. */
  .tile::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: #fff;
    opacity: 0;
    transition: opacity 300ms;
  }

  .tile-inner {
    position: relative;
    opacity: 1;
    transition: all 0.45s;
  }

  /* Both logos share one grid cell, so they are always the same size and
     position. (The live site pins the filled logo to the container's edges,
     which stretches it between 380–479px and 740–780px.) */
  .logo-stack {
    display: grid;
    justify-items: start;
  }

  .logo-outline,
  .logo-filled {
    grid-area: 1 / 1;
    width: 168px;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  .logo-filled {
    opacity: 0;
  }

  .tile-label {
    display: grid;
    grid-template-columns: 1fr;
    justify-content: center;
    justify-items: stretch;
  }

  .label-colour {
    position: absolute;
    justify-self: center;
    text-align: center;
  }

  .label-white {
    position: relative;
    color: #fff;
    text-align: center;
    font-family: var(--font-ui);
  }

  /* Active state, one look at every width (a deliberate change from the live
     site, which only did this from 768px up):
     - tile fades to white with a soft shadow
     - logo cross-fades to the coloured-in version, 500 ms
     - white title fades out, 100 ms, revealing the coloured one
     Triggered by hover on devices that can hover, and by scrolling on
     touch screens and narrow windows (the script on the home page toggles
     .is-active). */
  .logo-outline,
  .logo-filled {
    transition: opacity 500ms;
  }

  .label-white {
    transition: opacity 100ms;
  }

  .tile.is-active {
    box-shadow: 3px 3px 10px 1px var(--box-shadow);
  }

  .tile.is-active::before { opacity: 1; }
  .tile.is-active .logo-filled { opacity: 1; }
  .tile.is-active .logo-outline { opacity: 0; }
  .tile.is-active .label-white { opacity: 0; }

  @media (hover: hover) {
    .tile:hover {
      box-shadow: 3px 3px 10px 1px var(--box-shadow);
    }

    .tile:hover::before { opacity: 1; }
    .tile:hover .logo-filled { opacity: 1; }
    .tile:hover .logo-outline { opacity: 0; }
    .tile:hover .label-white { opacity: 0; }
  }

  @media screen and (max-width: 991px) {
    .logo-stack {
      justify-items: center;
    }

    .tile-inner {
      width: 40%;
    }
  }

  @media screen and (max-width: 767px) {
    .tile-inner {
      width: 50%;
    }
  }
</style>
